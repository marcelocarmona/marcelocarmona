{
  "name": "marcelocarmona-website",
  "version": "1.5.6",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "cross-env SOCKET=true node ./scripts/next-remote-watch.js ./data",
    "dev": "next dev",
    "build": "next build && node ./scripts/generate-sitemap",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "lint": "eslint --fix --ext .js,.jsx pages components lib layouts scripts",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/inter": "4.5.2",
    "@mdx-js/react": "^3.1.1",
    "@sentry/nextjs": "^10.40.0",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.12",
    "@vercel/analytics": "^1.6.1",
    "autoprefixer": "^10.4.14",
    "esbuild": "^0.27.3",
    "github-slugger": "^1.3.0",
    "gray-matter": "^4.0.2",
    "image-size": "1.0.0",
    "mdx-bundler": "^10.1.1",
    "next": "^15.5.7",
    "next-themes": "^0.0.14",
    "postcss": "^8.4.21",
    "preact": "^10.6.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "reading-time": "1.3.0",
    "rehype-autolink-headings": "^6.1.0",
    "rehype-citation": "^0.4.0",
    "rehype-katex": "^6.0.2",
    "rehype-preset-minify": "6.0.0",
    "rehype-prism-plus": "^1.1.3",
    "rehype-slug": "^5.0.0",
    "remark-footnotes": "^4.0.1",
    "remark-gfm": "^3.0.1",
    "remark-math": "^5.1.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "unist-util-visit": "^4.0.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.5.7",
    "@svgr/webpack": "^8.1.0",
    "cross-env": "^7.0.3",
    "dedent": "^0.7.0",
    "eslint": "^9.39.3",
    "eslint-config-next": "^15.5.7",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.4",
    "file-loader": "^6.0.0",
    "globby": "11.0.3",
    "husky": "^9.1.7",
    "inquirer": "^8.1.1",
    "lint-staged": "^15.5.2",
    "next-remote-watch": "^1.0.0",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "socket.io": "^4.4.0",
    "socket.io-client": "^4.4.0"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  }
}
