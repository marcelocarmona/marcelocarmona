    "cross-env": "^10.1.0",
    "dedent": "^1.7.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "inquirer": "^13.4.1",
    "lint-staged": "^16.4.0",
    "next-remote-watch": "^2.0.0",
    "prettier": "^3.8.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "socket.io": "^4.8.3",
